    .modal-spec-col {
      display: flex;
      flex-direction: column;
    }

    .modal-spec-label {
      font-size: 0.72rem;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--text-light);
    }

    .modal-spec-val {
      font-size: 0.95rem;
      font-weight: 800;
      color: var(--text-main);
    }

    /* Responsive */
    @media (max-width: 960px) {
      .hero {
        grid-template-columns: 1fr;
        padding: 40px 20px;
        text-align: center;
